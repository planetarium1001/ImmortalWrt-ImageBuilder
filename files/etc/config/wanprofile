# 站点 profile：校园 / 家用 / 临时。切换只改 WAN，不动 LAN 与防火墙。

config profile 'campus'
	option proto 'minieap'
	option device ''
	option username ''
	option password ''
	option module 'rjv3'
	option dhcp_type '1'
	option enabled '1'

config profile 'home'
	option proto 'dhcp'
	option device ''
	option username ''
	option password ''
	option enabled '1'

config profile 'adhoc'
	option proto 'dhcp'
	option device ''
	option username ''
	option password ''
	option enabled '1'

config globals 'globals'
	option active 'campus'
	option autodetect '1'
