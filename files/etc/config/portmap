# 端口角色映射表：只描述“物理口 → 角色”，不依赖内核枚举顺序。
# macaddr 为空时按 pci_slot 匹配；两者都为空则按 port 序号兜底。
# 首次开机由 /usr/sbin/portmap 解析成真实 ethX 并写入 /etc/config/network。

config portmap 'globals'
	option enabled '1'
	option fallback 'eth0'        # 全部匹配失败时的兜底 WAN 口

config port 'wan'
	option role 'wan'
	option port '1'
	option macaddr ''
	option pci_slot ''

config port 'lan1'
	option role 'lan'
	option port '2'
	option macaddr ''
	option pci_slot ''

config port 'lan2'
	option role 'lan'
	option port '3'
	option macaddr ''
	option pci_slot ''

config port 'lan3'
	option role 'lan'
	option port '4'
	option macaddr ''
	option pci_slot ''
