# nikki 主配置（UCI）。
#
# 字段名不是随便起的：nikki.init 与 ucode/mixin.uc 按固定名字读这些 option，
# 名字写错不会报错、只会静默失效（比如 tun 关不掉、mixin.yaml 不被合并）。
# 本文件的段名与字段名均对齐上游 nikki/files/nikki.conf（2026-11-02 核对）。
#
# 出厂 enabled=0：装好固件不自动接管流量，等用户在 LuCI 里填好订阅再启用。
# 锐捷认证网络环境尤其重要——首个联网动作交给用户的认证流程，而不是代理。

config status 'status'

config config 'config'
	# init=1 只是给 uci-defaults/init.sh 的标记：首启它会写入随机的 api_secret
	# 与认证密码，然后把 init 删掉。留着 1 而没人跑，比 api_secret 为空裸奔安全得多。
	option init '1'
	option enabled '0'
	# 订阅段名固定为 subscription，LuCI 的"节点/订阅"页签按这个名字找配置
	option profile 'subscription:subscription'
	# 延迟启动：开机时 WAN 往往还没拿到地址，立刻拉订阅会失败并让 nikki 直接退出
	option start_delay '15'
	option scheduled_restart '0'
	option scheduled_restart_cron '0 3 * * *'
	# 起之前先自检 profile，坏订阅不会留下一个"进程在、代理不通"的半死状态
	option test_profile '1'
	option core_only '0'

config procd 'procd'
	option fast_reload '0'
	option env_disable_loopback_detector '0'
	option env_disable_quic_go_gso '0'
	option env_disable_quic_go_ecn '0'
	option env_skip_system_ipv6_check '0'
	option rlimit_nofile_soft '65536'
	option rlimit_nofile_hard '65536'

config core 'core'
	option redirect_listener_name 'redir-in'
	option tproxy_listener_name 'tproxy-in'
	option tun_listener_name 'tun-in'

config subscription 'subscription'
	option name 'default'
	# 占位地址：必须改成自己的订阅再启用。留着它是为了让 LuCI 订阅页有可编辑的初始行。
	option url 'http://example.com/default.yaml'
	option user_agent 'clash'
	option prefer 'remote'

config mixin 'mixin'
	option log_level 'warning'
	# 白名单只能跑在 rule 模式：global 模式会把所有流量送进代理，与白名单语义相反
	option mode 'rule'
	option match_process 'off'
	option ipv6 '1'
	option ui_path 'ui'
	option ui_url 'https://github.com/Zephyruso/zashboard/releases/latest/download/dist-cdn-fonts.zip'
	# 管理面绑 0.0.0.0：本机是软路由，LAN 侧要能直接开面板看实时连接
	option api_listen '0.0.0.0:9090'
	option selection_cache '1'
	# 透明代理必须允许非本机来源回连：REDIRECT 把 LAN 客户端的连接投递到本机端口，
	# 这个来源在 mihomo 眼里就是"局域网"。关掉它 = 只有路由器自己能被代理。
	option allow_lan '1'
	# 7890/8080/1080 是留给宿主排障的旁路端口；透明代理真正用的是下面的 redir_port
	option http_port '8080'
	option socks_port '1080'
	option mixed_port '7890'
	# 透明代理端口：7893（避开 7890/7891/7892 这组 mihomo 常见默认值，
	# 也与可能同时存在的 clash 系插件的默认端口错开）
	option redir_port '7893'
	option tproxy_port '7892'
	option authentication '1'
	# TUN 关闭：x86 软路由走 REDIRECT/TPROXY 就够，TUN 会额外占 CPU，
	# 而且 tun 设备与 fw4 的转发链更容易互相打架
	option tun_enabled '0'
	option tun_device 'nikki'
	option tun_stack 'mixed'
	option tun_dns_hijack '0'
	list tun_dns_hijacks 'tcp://any:53'
	list tun_dns_hijacks 'udp://any:53'
	option dns_enabled '1'
	# mihomo 的 DNS 只服务它自己：1053 而不是 53，53 继续归 dnsmasq。
	# 两个 DNS 抢 53 是 nikki 接入后最常见的"随机解析失败"来源，从端口上就分开。
	option dns_listen '[::]:1053'
	option dns_ipv6 '1'
	option dns_mode 'fake-ip'
	option fake_ip_range '198.18.0.1/16'
	# 过滤器交给 /etc/nikki/mixin.yaml 统一维护（本开关置 0 时 UCI 不覆盖它），
	# 避免同一份清单在 UCI 与 yaml 两处各写一遍、改一处忘一处
	option fake_ip_filter '0'
	list fake_ip_filters '+.lan'
	list fake_ip_filters '+.local'
	option fake_ip_cache '1'
	option hosts '0'
	option dns_nameserver '0'
	option proxy_server_nameserver_policy '0'
	option dns_direct_nameserver_follow_policy '0'
	option dns_nameserver_policy '0'
	# sniffer 打开的原因：不劫持 DNS 就拿不到 fake-ip 映射，mihomo 看到的只有目的 IP，
	# 域名规则（白名单）会全部匹配不上、退化成"全部直连"。
	# sniffer 从 TLS SNI / HTTP Host / QUIC Initial 里把域名还原出来，白名单才成立。
	option sniffer '1'
	option sniffer_sniff '1'
	option sniffer_force_domain_name '0'
	option sniffer_ignore_domain_name '0'
	option rule '0'
	option rule_provider '0'
	# 关键开关：不开它，/etc/nikki/mixin.yaml 根本不会被合并（默认 0 且不明显）
	option mixin_file_content '1'

config authentication
	option enabled '1'
	option username 'nikki'
	# 密码留空：由 uci-defaults/init.sh 在首启写入随机值，镜像里不存在可复用的默认口令
	option password ''

config hosts
	option enabled '0'
	option domain_name 'localhost'
	list ip '127.0.0.1'
	list ip '::1'

config nameserver
	option enabled '1'
	option type 'default-nameserver'
	list nameserver '223.5.5.5'
	list nameserver '223.6.6.6'

config nameserver
	option enabled '0'
	option type 'proxy-server-nameserver'
	list nameserver 'https://223.5.5.5/dns-query'
	list nameserver 'https://223.6.6.6/dns-query'

config nameserver
	option enabled '0'
	option type 'direct-nameserver'
	list nameserver 'https://223.5.5.5/dns-query'
	list nameserver 'https://223.6.6.6/dns-query'

config nameserver
	option enabled '1'
	option type 'nameserver'
	list nameserver 'https://223.5.5.5/dns-query'
	list nameserver 'https://223.6.6.6/dns-query'

config nameserver_policy
	option enabled '1'
	option matcher 'geosite:private,cn'
	list nameserver 'https://223.5.5.5/dns-query'
	list nameserver 'https://223.6.6.6/dns-query'

config nameserver_policy
	option enabled '1'
	option matcher 'geosite:geolocation-!cn'
	list nameserver 'https://1.1.1.1/dns-query'
	list nameserver 'https://8.8.8.8/dns-query'

config sniff
	option enabled '1'
	option protocol 'HTTP'
	list port '80'
	list port '8080'
	option overwrite_destination '1'

config sniff
	option enabled '1'
	option protocol 'TLS'
	list port '443'
	list port '8443'
	option overwrite_destination '1'

config sniff
	option enabled '1'
	option protocol 'QUIC'
	list port '443'
	list port '8443'
	option overwrite_destination '1'

config proxy 'proxy'
	# proxy.enabled=1：总开关仍在 config.enabled，这里只是把"接管方式"预置好，
	# 用户把总开关打开就能工作，不必再翻一遍代理设置
	option enabled '1'
	# TCP 走 REDIRECT；UDP 走 TPROXY（REDIRECT 只拦 TCP，
	# 想代理 QUIC 只能用 TPROXY，内核侧依赖 kmod-nft-tproxy，已在 PACKAGES 里）
	option tcp_mode 'redirect'
	option udp_mode 'tproxy'
	# 不劫持局域网 DNS：dnsmasq 仍是 LAN 的唯一解析器，终端拿到的也是真实地址。
	# 代价是域名规则要靠 sniffer 还原（见上面 sniffer 段）。
	option ipv4_dns_hijack '0'
	option ipv6_dns_hijack '0'
	option ipv4_proxy '1'
	option ipv6_proxy '1'
	option fake_ip_ping_hijack '0'
	option router_proxy '1'
	option lan_proxy '1'
	list lan_inbound_interface 'lan'
	list reserved_ip '0.0.0.0/8'
	list reserved_ip '10.0.0.0/8'
	list reserved_ip '127.0.0.0/8'
	list reserved_ip '100.64.0.0/10'
	list reserved_ip '169.254.0.0/16'
	list reserved_ip '172.16.0.0/12'
	list reserved_ip '192.168.0.0/16'
	list reserved_ip '224.0.0.0/4'
	list reserved_ip '240.0.0.0/4'
	list reserved_ip6 '::/128'
	list reserved_ip6 '::1/128'
	list reserved_ip6 '::ffff:0:0/96'
	list reserved_ip6 '100::/64'
	list reserved_ip6 '64:ff9b::/96'
	list reserved_ip6 '2001::/32'
	list reserved_ip6 '2001:10::/28'
	list reserved_ip6 '2001:20::/28'
	list reserved_ip6 '2001:db8::/32'
	list reserved_ip6 '2002::/16'
	list reserved_ip6 'fc00::/7'
	list reserved_ip6 'fe80::/10'
	list reserved_ip6 'ff00::/8'
	list bypass_dscp '4'
	option bypass_china_mainland_ip '0'
	option bypass_china_mainland_ip6 '0'
	option proxy_tcp_dport '0-65535'
	option proxy_udp_dport '0-65535'
	option tun_timeout '30'
	option tun_interval '1'

config router_access_control
	option enabled '1'
	# 这些用户/组/cgroup 是本机系统服务，走代理既无意义又会污染统计与认证流量
	list user 'dnsmasq'
	list user 'ftp'
	list user 'logd'
	list user 'nobody'
	list user 'ntp'
	list user 'ubus'
	list group 'dnsmasq'
	list group 'ftp'
	list group 'logd'
	list group 'nogroup'
	list group 'ntp'
	list group 'ubus'
	list cgroup 'services/adguardhome'
	list cgroup 'services/aria2'
	list cgroup 'services/dnsmasq'
	list cgroup 'services/netbird'
	list cgroup 'services/qbittorrent'
	list cgroup 'services/sysntpd'
	list cgroup 'services/tailscale'
	list cgroup 'services/zerotier'
	option dns '0'
	option proxy '0'

config router_access_control
	option enabled '1'
	option dns '1'
	option proxy '1'

config lan_access_control
	option enabled '1'
	option dns '1'
	option proxy '1'

config routing 'routing'
	option tproxy_fw_mark '0x80'
	option tproxy_fw_mask '0xFF'
	option tun_fw_mark '0x81'
	option tun_fw_mask '0xFF'
	option tproxy_rule_pref '1024'
	option tun_rule_pref '1025'
	option tproxy_route_table '80'
	option tun_route_table '81'
	option cgroup_id '0x12061206'
	option cgroup_name 'nikki'
	option dummy_device 'nikki-dummy'

config editor 'editor'

config log 'log'
	option clear_at_stop '1'
	option scheduled_clear '1'
	option scheduled_clear_cron '*/5 * * * *'
	option scheduled_clear_size_limit '1'
	option scheduled_clear_size_limit_unit 'MB'
