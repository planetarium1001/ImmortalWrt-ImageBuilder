# swapfile 配置：不用 swap 分区，大小可随时调整。
# file 落在 @swap 子卷里（/swap/swapfile）：btrfs 上 swapfile 必须 NOCOW，
# 由 swapctl 创建时置 chattr +C（@swap 根目录已有 C 时直接继承）。
config swap 'globals'
	option enabled '1'
	option file '/swap/swapfile'
	option size_mb '4096'
	option swappiness '20'
	option zram '1'
	option zram_percent '50'
