# WAN 探测与投票策略。所有端点可改，不写死在脚本里。

config wandetect 'globals'
	option enabled '1'
	option interval '30'
	option cooldown '30'
	option max_attempts '5'
	option timeout '3'
	option quorum_online '2'
	option quorum_offline '0'
	option iface 'eth0'
	option dns_server '223.5.5.5'
	option dns_probe 'www.baidu.com'
	option trigger_minieap '1'

# 204 型探针：期望 204 且无 Location
config probe
	option name 'hicloud'
	option url 'http://connectivitycheck.platform.hicloud.com/generate_204'
	option type '204'
	option enabled '1'

config probe
	option name 'vivo'
	option url 'http://wifi.vivo.com.cn/generate_204'
	option type '204'
	option enabled '1'

config probe
	option name 'miui'
	option url 'http://connect.rom.miui.com/generate_204'
	option type '204'
	option enabled '1'

config probe
	option name 'gstatic'
	option url 'http://connectivitycheck.gstatic.com/generate_204'
	option type '204'
	option enabled '1'

config probe
	option name 'firefox'
	option url 'http://detectportal.firefox.com/success.txt'
	option type 'content'
	option expect 'success'
	option enabled '1'

config probe
	option name 'apple'
	option url 'http://captive.apple.com/hotspot-detect.html'
	option type 'content'
	option expect 'Success'
	option enabled '1'

config probe
	option name 'msft'
	option url 'http://www.msftconnecttest.com/connecttest.txt'
	option type 'content'
	option expect 'Microsoft Connect Test'
	option enabled '0'

config icmp
	option host '223.5.5.5'

config icmp
	option host '180.76.76.76'

config icmp
	option host '1.1.1.1'
