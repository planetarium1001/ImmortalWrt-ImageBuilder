#!/bin/sh /etc/rc.common
# minieap 开机自启：只做认证，不参与地址分配。
# 地址由 WAN 接口的原生 proto dhcp 负责（netifd 内置 DHCP 客户端）。
START=90
STOP=10
USE_PROCD=1

start_service() {
	[ -f /etc/minieap.conf ] || {
		logger -t minieap "缺少 /etc/minieap.conf，跳过启动"
		return 0
	}
	# 账号为空时不必启动，避免无意义的重试刷日志
	user=$(sed -n 's/^username=//p' /etc/minieap.conf | head -n1)
	[ -n "$user" ] || {
		logger -t minieap "username 为空，跳过启动"
		return 0
	}

	procd_open_instance minieap
	# 只传 --conf-file：其余参数全部来自配置文件。
	# 不加 --daemonize：minieap 自己 fork 后 procd 记录的 pid 会立即退出，
	# 导致 restart 不生效、logread 也看不到输出。前台运行交给 procd 托管。
	procd_set_param command /usr/sbin/minieap --conf-file /etc/minieap.conf
	# 退出即重启，不设上限：认证服务短暂不可用时不能永久放弃
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
