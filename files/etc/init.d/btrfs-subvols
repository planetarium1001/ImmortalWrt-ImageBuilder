#!/bin/sh /etc/rc.common
# btrfs-subvols —— 开机把 @docker / @swap / @data 三个子卷挂到各自的挂载点。
#
# 为什么不用 /etc/config/fstab：block 的段去重键是 uuid|label|device，同一设备只认一段
# mount（mounts_update() 是空函数，同 label 的第二段会静默顶掉第一段）。extroot 段已经占位，
# 所以这三段只能在 init 脚本里挂。
#
# 挂载参数只有 noatime,subvol=…：compress=/space_cache=/discard=/nodatacow 都是**整个文件
# 系统共享**的挂载参数，由首次挂载（preinit 的 @overlay 那一段）决定；
# 写在这里既不能按子卷分，也不生效。"@docker/@swap 不 CoW" 只能靠 chattr +C，
# 属性持久化在文件系统里，但每次开机复核一次（属性可能在复制/换盘后丢失）。
#
# 失败处理：p3 缺失或挂不上 → 记 ERROR、**不挂空目录**（空目录会让 dockerd 把容器写进
# 系统层 @overlay，写满即 ENOSPC 连坐）、返回非 0。返回非 0 不会阻断 boot（rcS 继续跑），
# 但 docker 的挂载点不存在，dockerd 无法正常启动。
#
# 运行期绝不写 /etc/config/fstab：那是 squashfs 里的只读真源，运行期改它既不影响
# preinit 也不影响下次升级，只会制造"看起来改了"的假象。本脚本每次开机自愈。
#
# START=12：晚于 fstab(START=11) 与 preinit 的 extroot，早于 dockerd(START=99)。
#
# 与 uci-defaults 的关系（审计点名过"文档与实现相反"）：
#   /etc/init.d/boot 是 START=10，uci-defaults（含 99-custom.sh）在**它**里面执行，
#   所以 99-custom.sh 跑的时候本脚本还没跑、/swap 与 /opt/docker 都不存在。
#   ⇒ swap 的自启**不能**指望 uci-defaults（它那次必然失败，且失败后 uci-defaults 自删不再重试），
#     真正的自启就在这里：@swap 挂好、NOCOW 复核完，再 best-effort 调 swapctl apply。
#   99-custom.sh 里保留的那次调用只是"顺手补一次"，/swap 未挂时会记 deferred 跳过。

START=12

DOCKER_DIR=${DOCKER_DIR:-/opt/docker}
SWAP_DIR=${SWAP_DIR:-/swap}
DATA_DIR=${DATA_DIR:-/data}
LABEL=${OVERLAY_LABEL:-wrt-overlay}
MOUNT=${MOUNT:-mount}
SWAPCTL=${SWAPCTL:-/usr/sbin/swapctl}
BTRFS=${BTRFS:-btrfs}
PROC_MOUNTS=${PROC_MOUNTS:-/proc/mounts}
LSATTR=${LSATTR:-lsattr}
CHATTR=${CHATTR:-chattr}
LOG=${BTRFS_SUBVOLS_LOG:-/etc/config/btrfs-subvols.log}

log() {
	_msg="$(date '+%F %T') $*"
	printf '%s\n' "$_msg" >>"$LOG" 2>/dev/null || true
}

# 从 btrfs filesystem show 的输出里取设备路径：不写死 /dev/sda3（NVMe 是 nvme0n1p3）。
p3_dev() {
	_show=$("$BTRFS" filesystem show "$LABEL" 2>/dev/null) || return 1
	_dev=$(printf '%s\n' "$_show" | awk '$1 == "devid" { print $NF; exit }')
	[ -n "${_dev:-}" ] || return 1
	printf '%s\n' "$_dev"
}

# 挂载信息一律读 /proc/mounts：25.12.2 x86_64 源里没有 findmnt（util-linux 不装），
# 用它判断"是否已挂载"会永远失败 → 每次开机重复 mount、报错、退出非 0。
mounted() { # <挂载点>
	awk -v m="$1" '$2 == m { found = 1; exit } END { exit !found }' "$PROC_MOUNTS" 2>/dev/null
}

have_cmd() { command -v "$1" >/dev/null 2>&1; }

mount_one() { # <subvol> <挂载点>
	if mounted "$2"; then
		log "已挂载，跳过: $2（$1）"
		return 0
	fi
	_created=0
	if [ ! -d "$2" ]; then
		if mkdir -p "$2" 2>/dev/null; then
			_created=1
		else
			log "ERROR: 无法创建挂载点 $2"
			return 1
		fi
	fi
	if "$MOUNT" -t btrfs -o "noatime,subvol=$1" "$DEV" "$2" >>"$LOG" 2>&1; then
		log "挂载 $1 → $2"
		return 0
	fi
	# 挂不上就把刚建的空目录撤掉，别留个空壳误导 dockerd
	[ "$_created" = 1 ] && rmdir "$2" 2>/dev/null
	log "ERROR: 挂载 $1 → $2 失败（p3 未就绪或子卷缺失）"
	return 1
}

# 子卷根目录必须带 C（NOCOW），否则 swapfile 直接被内核拒绝。
# chattr/lsattr 在 25.12 是**独立 apk 包**（不在 e2fsprogs 里）：缺了只记日志、继续，
# 不阻断开机 —— @docker 退回 CoW 仍可用，swapfile 的问题由 swapctl 侧显式报错。
ensure_nocow() { # <挂载点>
	if have_cmd "$LSATTR"; then
		_flags=$("$LSATTR" -d "$1" 2>/dev/null | awk 'NR == 1 { print $1 }')
		case "${_flags:-}" in
		*C*) return 0 ;;
		esac
	else
		log "WARN: 找不到 lsattr（lsattr 包缺失），无法复核 $1 的 NOCOW 标志；仍尝试 chattr +C"
	fi
	if ! have_cmd "$CHATTR"; then
		log "ERROR: 找不到 chattr（chattr 包缺失）：$1 无法设 NOCOW，退回 CoW（swapfile 可能无法 swapon，见 swapctl）"
		return 0
	fi
	if "$CHATTR" +C "$1" 2>>"$LOG"; then
		log "补设 chattr +C（NOCOW）: $1"
		return 0
	fi
	log "WARN: chattr +C $1 失败（swapfile 可能无法 swapon，docker 层会退回 CoW）"
	return 1
}

start() {
	: >"$LOG" 2>/dev/null || true
	log "=== btrfs-subvols start ==="
	if ! DEV=$(p3_dev); then
		log "ERROR: 找不到 label=$LABEL 的 btrfs 分区（p3 未建 / 未就绪）：不挂任何子卷，docker 数据目录不可用"
		return 1
	fi
	log "btrfs 设备: $DEV"

	_rc=0
	if mount_one @docker "$DOCKER_DIR"; then
		ensure_nocow "$DOCKER_DIR" || _rc=1
	else
		_rc=1
	fi
	if mount_one @swap "$SWAP_DIR"; then
		ensure_nocow "$SWAP_DIR" || _rc=1
		# swap 的自启放这里，不放 uci-defaults：/etc/init.d/boot 是 START=10，
		# 那时 @swap 还没挂（本脚本 START=12 才挂），swapctl apply 必然报"目录不存在"；
		# 而 uci-defaults 返回 0 就自删、永久不再重试 ⇒ swap 会永久缺位。
		# 放在这里的好处：顺序天然正确，且每次开机都会补齐。
		if [ -x "$SWAPCTL" ]; then
			if "$SWAPCTL" apply >>"$LOG" 2>&1; then
				log "swapctl apply 完成（swapfile 落在 @swap 上）"
			else
				log "WARN: swapctl apply 失败（swap 本次未启用；子卷挂载不受影响，详见 /etc/config/overlay-setup.log 与 swapctl 输出）"
			fi
		else
			log "WARN: 找不到 ${SWAPCTL}，跳过 swap 自启"
		fi
	else
		_rc=1
	fi
	mount_one @data "$DATA_DIR" || _rc=1

	if [ "$_rc" = 0 ]; then
		log "子卷挂载完成"
	else
		log "ERROR: 有子卷未就绪（见上），docker 数据目录可能不可用"
	fi
	return "$_rc"
}

stop() {
	# 不在这里卸载：dockerd(START=99) 会先停，卸载留给关机流程。
	# 在这里 umount 反而会让运行中的 docker 突然失去数据目录。
	return 0
}
