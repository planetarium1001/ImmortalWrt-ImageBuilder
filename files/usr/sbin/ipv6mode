#!/bin/sh
# ipv6mode —— 兼容壳（deprecated）：IPv6 维度已并入 netprofile，本脚本只做映射转发
#
# 用法：ipv6mode [nat66|native|off|status|forget <mode>]
#
#   nat66   → netprofile campus   （campus 模板：ula_prefix=fd7a:6e64:6c35::/48、
#                                   wan6.auto='1'、wan6.reqprefix='no'、masq6=1）
#   native  → netprofile home     （home 模板：不做 NAT66，不写 ULA 与 masq6）
#   off     → 在当前 profile 上关掉内网 IPv6（wan6.auto=0、ra/dhcpv6 disabled、
#            删掉 ula_prefix 与 masq6）。off 不写任何存档，并清掉 profile 标记：
#            下次 netprofile <档> 会整档重套该档（存档/模板），off 不会被"记住"。
#   status  → netprofile status
#   forget  → netprofile forget <campus|home>（nat66→campus、native→home）
#
# 旧的 /etc/config/ipv6mode.d/*.state 与 /etc/config/ipv6mode 状态文件已废弃，
# 不再读写；检测到旧存档时只提示一次人工处理方式。
#
# 为什么要这么改：原实现 nat66 把 network.wan6.auto 置 0（netifd 里它是 autostart），
# WAN 侧根本没有 IPv6，masq6 无源可 NAT。修正在 netprofile 的模板里
# （campus: wan6.auto='1'），本脚本不再自己持有模板。

NETPROFILE=/usr/sbin/netprofile
CUR_FILE=/etc/netprofile
LEGACY_DIR=/etc/config/ipv6mode.d
LEGACY_STATE=/etc/config/ipv6mode

usage() {
	cat <<'EOF'
用法: ipv6mode [nat66|native|off|status|forget <mode>]
  nat66   等价 netprofile campus（NAT66：ULA + masq6=1）
  native  等价 netprofile home
  off     在当前 profile 上关闭内网 IPv6（不单独存档）
  status  等价 netprofile status
  forget  <nat66|native> 删除对应 profile 存档
（ipv6mode 已并入 netprofile，新配置请直接用 netprofile）
EOF
}

# 旧存档废弃提示（只在旧文件存在时提示，不自动迁移：旧存档缺少新受管键，
# 半套迁移比不迁移更容易出事）
legacy_note() {
	if [ -f "$LEGACY_STATE" ] || [ -d "$LEGACY_DIR" ]; then
		printf 'ipv6mode: 旧存档 %s / %s 已废弃，不再读取；如需保留旧手改，请先 uci 设置再执行 netprofile campus|home\n' \
			"$LEGACY_DIR" "$LEGACY_STATE" >&2
	fi
}

# WAN 区域段名运行时解析（与 netprofile 同一纪律：解析不到就报错，不猜 @zone[N]）
wanzone() {
	for _sec in $(uci -q show firewall 2>/dev/null | sed -n 's/^\(firewall\.[^.=]*\)\.name=.*/\1/p'); do
		_zn=$(uci -q get "$_sec.name" 2>/dev/null | tr -d "'\"")
		if [ "$_zn" = 'wan' ]; then
			printf '%s' "${_sec#firewall.}"
			return 0
		fi
	done
	return 1
}

# 关闭内网 IPv6：只动 IPv6 维度这几个受管键，其余配置不碰
ipv6_off() {
	if ! _zone=$(wanzone) || [ -z "$_zone" ]; then
		printf 'ipv6mode: ERROR: firewall 里找不到 name=wan 的 zone，无法定位 masq6（不猜 @zone[N]）\n' >&2
		exit 3
	fi
	uci set network.wan6.proto='dhcpv6'
	uci set network.wan6.auto='0'
	uci -q delete network.wan6.reqprefix
	uci -q delete network.globals.ula_prefix
	uci set dhcp.lan.ra='disabled'
	uci set dhcp.lan.dhcpv6='disabled'
	uci -q delete dhcp.lan.ra_flags
	uci -q delete "firewall.$_zone.masq6"
	uci commit network
	uci commit dhcp
	uci commit firewall
	/etc/init.d/network reload || exit 1
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || :
	/etc/init.d/firewall reload || exit 1
	# off 不是 profile：清掉 profile 标记，避免下一次切换把 off 的键值当成该档的"手改记忆"
	rm -f "$CUR_FILE"
	printf 'ipv6mode: 已在当前配置上关闭内网 IPv6（不存档、已清除 profile 标记；下次 netprofile campus|home 会整档重套）\n'
}

legacy_note

case "$1" in
nat66)
	[ -x "$NETPROFILE" ] || { printf 'ipv6mode: ERROR: 缺 %s\n' "$NETPROFILE" >&2; exit 1; }
	exec "$NETPROFILE" campus
	;;
native)
	[ -x "$NETPROFILE" ] || { printf 'ipv6mode: ERROR: 缺 %s\n' "$NETPROFILE" >&2; exit 1; }
	exec "$NETPROFILE" home
	;;
off)
	ipv6_off
	;;
status)
	[ -x "$NETPROFILE" ] || { printf 'ipv6mode: ERROR: 缺 %s\n' "$NETPROFILE" >&2; exit 1; }
	exec "$NETPROFILE" status
	;;
forget)
	case "${2:-}" in
	nat66 | campus)
		[ -x "$NETPROFILE" ] || { printf 'ipv6mode: ERROR: 缺 %s\n' "$NETPROFILE" >&2; exit 1; }
		exec "$NETPROFILE" forget campus
		;;
	native | home)
		[ -x "$NETPROFILE" ] || { printf 'ipv6mode: ERROR: 缺 %s\n' "$NETPROFILE" >&2; exit 1; }
		exec "$NETPROFILE" forget home
		;;
	off)
		printf 'ipv6mode: off 不单独存档（IPv6 维度已并入 profile 存档）\n'
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
	;;
help | -h | --help)
	usage
	;;
*)
	usage >&2
	exit 2
	;;
esac
exit 0
