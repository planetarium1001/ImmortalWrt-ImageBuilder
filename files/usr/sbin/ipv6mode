#!/bin/sh
# ipv6mode —— IPv6 三态开关，带每模式记忆
#
#   nat66   上级只给单地址、不给 PD 时用：内网 ULA + WAN 出口 masq6
#   native  家宽正常下发 PD 时用：内网直接分配上级前缀，不做 NAT66
#   off     完全关闭内网 IPv6
#
# 用法：ipv6mode [nat66|native|off|status|forget]
#
# 记忆：切换前把当前模式受管的 8 个键存到 /etc/config/ipv6mode.d/<模式>.state，
# 切回该模式时优先恢复存档；没有存档才套模板。因此每个模式各自记住你的调整。
# 受管键之外的任何配置都不会被本脚本碰。

ULA='fd7a:6e64:6c35::/48'
STATE_DIR=/etc/config/ipv6mode.d
CUR_FILE=/etc/config/ipv6mode

# 受管的键（其余一律不碰）
KEYS="network.globals.ula_prefix network.wan6.auto network.wan6.proto \
dhcp.lan.ra dhcp.lan.dhcpv6 dhcp.lan.ndp dhcp.lan.ra_flags"

# WAN 区域名运行时解析，避免依赖 @zone[N] 索引（索引在用户改过防火墙后会变）
wanzone() {
	for sec in $(uci -q show firewall 2>/dev/null | sed -n 's/^\(firewall\.[^.=]*\)\.name=.*/\1/p'); do
		v=$(uci -q get "$sec.name" 2>/dev/null | tr -d "'\"")
		[ "$v" = "wan" ] && { echo "${sec#firewall.}"; return; }
	done
	echo "@zone[1]"
}

keys_all() {
	for k in $KEYS; do echo "$k"; done
	echo "firewall.$(wanzone).masq6"
}

save_state() {
	_mode=$1
	mkdir -p "$STATE_DIR" 2>/dev/null
	_f="$STATE_DIR/$_mode.state"
	: >"$_f"
	for k in $(keys_all); do
		v=$(uci -q get "$k" 2>/dev/null)
		case "$k" in
			dhcp.lan.ra_flags)
				v=$(echo "$v" | tr ' ' ',')
				;;
		esac
		[ -n "$v" ] || v='-'
		echo "$k=$v" >>"$_f"
	done
}

restore_state() {
	_f="$STATE_DIR/$1.state"
	[ -f "$_f" ] || return 1
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		k=${line%%=*}; v=${line#*=}
		[ -n "$k" ] || continue
		case "$k" in
			dhcp.lan.ra_flags)
				uci -q delete "$k"
				[ "$v" = "-" ] && continue
				for item in $(echo "$v" | tr ',' ' '); do uci add_list "$k=$item"; done
				;;
			*)
				if [ "$v" = "-" ]; then uci -q delete "$k"; else uci set "$k=$v"; fi
				;;
		esac
	done <"$_f"
	return 0
}

apply_default() {
	case "$1" in
		nat66)
			uci set network.globals.ula_prefix="$ULA"
			uci set network.wan6.auto='0'
			uci set network.wan6.proto='dhcpv6'
			uci set dhcp.lan.ra='server'
			uci set dhcp.lan.dhcpv6='server'
			uci set dhcp.lan.ndp='disabled'
			uci -q delete dhcp.lan.ra_flags
			uci add_list dhcp.lan.ra_flags='managed-config'
			uci add_list dhcp.lan.ra_flags='other-config'
			uci set "firewall.$(wanzone).masq6=1"
			;;
		native)
			uci -q delete network.globals.ula_prefix
			uci set network.wan6.auto='1'
			uci set network.wan6.proto='dhcpv6'
			uci set dhcp.lan.ra='server'
			uci set dhcp.lan.dhcpv6='server'
			uci set dhcp.lan.ndp='disabled'
			uci -q delete dhcp.lan.ra_flags
			uci add_list dhcp.lan.ra_flags='managed-config'
			uci add_list dhcp.lan.ra_flags='other-config'
			uci -q delete "firewall.$(wanzone).masq6"
			;;
		off)
			uci -q delete network.globals.ula_prefix
			uci set network.wan6.auto='0'
			uci set network.wan6.proto='dhcpv6'
			uci set dhcp.lan.ra='disabled'
			uci set dhcp.lan.dhcpv6='disabled'
			uci -q delete "firewall.$(wanzone).masq6"
			;;
	esac
}

reload_all() {
	uci commit network; uci commit dhcp; uci commit firewall
	/etc/init.d/network reload >/dev/null 2>&1
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	/etc/init.d/firewall reload >/dev/null 2>&1
}

cur=$(cat "$CUR_FILE" 2>/dev/null)

case "$1" in
	nat66|native|off)
		target=$1
		[ "$cur" = "$target" ] && { echo "ipv6 已是 $target（如需重置模板用 forget $target）"; exit 0; }
		[ -n "$cur" ] && save_state "$cur" && echo "已保存 $cur 的当前设置"
		if restore_state "$target"; then
			echo "已恢复 $target 上次的调整"
		else
			apply_default "$target"
			echo "已套用 $target 默认模板"
		fi
		echo "$target" >"$CUR_FILE"
		reload_all
		echo "ipv6 mode -> $target"
		;;
	status)
		echo "当前模式: ${cur:-未设置}"
		for k in $(keys_all); do
			v=$(uci -q get "$k" 2>/dev/null)
			printf '  %-32s %s\n' "$k" "${v:-(未设置)}"
		done
		echo "存档:"
		for f in "$STATE_DIR"/*.state; do
			[ -f "$f" ] && echo "  $(basename "$f" .state)"
		done
		;;
	forget)
		[ -z "$1" ] && { echo "usage: ipv6mode forget <mode>" >&2; exit 2; }
		rm -f "$STATE_DIR/$2.state"
		echo "已删除 $2 的存档，下次切回将用默认模板"
		;;
	*)
		echo "usage: ipv6mode nat66|native|off|status|forget <mode>" >&2
		exit 2
		;;
esac
