#!/bin/sh
# 扩容脚本：按挂载点反查分区，把可写文件系统扩满所在磁盘。
#
# 为什么按挂载点而不是直接找 /：OpenWrt 常把根显示成 /dev/root，
# 无法从名字反推分区；而 squashfs 镜像的可写空间在 /overlay，
# 只扩 / 是扩不到的。
#
# 用法：
#   rootfs-expand          执行扩容
#   rootfs-expand --dry-run 只打印判定结果
#   rootfs-expand --verbose 打印每一步

DRY=0
VERBOSE=0
LOG=/etc/config/rootfs-expand.log
log() { echo "$(date '+%F %T') $*" >>"$LOG" 2>/dev/null; [ "$VERBOSE" = "1" ] && echo "$*"; }

for a in "$@"; do
	case "$a" in
		--dry-run) DRY=1 ;;
		--verbose) VERBOSE=1 ;;
	esac
done

# 取挂载点的设备号与文件系统类型
mount_info() {
	mp=$1
	line=$(awk -v m="$mp" '$5==m {print $0; exit}' /proc/self/mountinfo 2>/dev/null)
	[ -n "$line" ] || return 1
	devno=$(echo "$line" | awk '{print $3}')
	fstype=$(echo "$line" | awk '{for(i=7;i<=NF;i++) if($i=="-"){print $(i+1); exit}}')
	echo "$devno $fstype"
}

# 设备号 -> 真实块设备名与文件名
dev_name() {
	maj=${1%:*}; min=${1#*:}
	uevent=/sys/dev/block/$maj:$min/uevent
	[ -f "$uevent" ] || return 1
	dev=$(sed -n 's/^DEVNAME=//p' "$uevent" | head -n1)
	[ -n "$dev" ] || return 1
	echo "$dev"
}

grow_one() {
	mp=$1
	info=$(mount_info "$mp") || { log "$mp 未挂载，跳过"; return 0; }
	devno=${info% *}; fstype=${info#* }
	devname=$(dev_name "$devno") || { log "$mp 设备无法解析（$devno），跳过"; return 0; }
	[ -b "/dev/$devname" ] || { log "$mp 的 $devname 不是块设备（可能 tmpfs），跳过"; return 0; }

	case "$fstype" in
		squashfs) log "$mp 是 squashfs（只读），跳过"; return 0 ;;
		ext4|ext3|ext2|f2fs) ;;
		*) log "$mp 文件系统 $fstype 不支持在线扩容，跳过"; return 0 ;;
	esac

	# 只处理常见的真实块设备；dm-/loop/md 之类一律不碰
	case "$devname" in
		sd*|hd*|vd*|nvme*|mmcblk*) ;;
		*) log "$devname 不是可扩的物理分区，跳过"; return 0 ;;
	esac

	# 分区号与磁盘名
	case "$devname" in
		nvme*n[0-9]p[0-9]*) disk=${devname%p[0-9]*}; part=${devname##*p} ;;
		mmcblk[0-9]p[0-9]*) disk=${devname%p[0-9]*}; part=${devname##*p} ;;
		*[0-9]) disk=$(echo "$devname" | sed 's/[0-9][0-9]*$//'); part=$(echo "$devname" | sed 's/.*[^0-9]\([0-9][0-9]*\)$/\1/') ;;
		*) log "$devname 无法解析分区号，跳过"; return 0 ;;
	esac

	log "$mp -> /dev/$devname ($fstype) 磁盘=$disk 分区=$part"
	[ "$DRY" = "1" ] && return 0

	if command -v parted >/dev/null 2>&1; then
		parted -s ---pretend-input-tty "/dev/$disk" resizepart "$part" 100% >>"$LOG" 2>&1
	else
		echo ",+," | sfdisk --force --no-reread -N "$part" "/dev/$disk" >>"$LOG" 2>&1
	fi

	# parted 不一定通知内核，必须主动刷新分区表
	if command -v partx >/dev/null 2>&1; then
		partx -u "/dev/$disk" >>"$LOG" 2>&1 || log "WARN: partx -u 失败（分区表可能未刷新）"
	else
		log "WARN: 缺少 partx（应装 partx-utils），分区表可能未刷新"
		blockdev --rereadpt "/dev/$disk" >>"$LOG" 2>&1
	fi

	case "$fstype" in
		f2fs) resize.f2fs "/dev/$devname" >>"$LOG" 2>&1 ;;
		*)    resize2fs "/dev/$devname" >>"$LOG" 2>&1 ;;
	esac || { log "ERROR: $devname 文件系统扩容失败"; return 0; }

	# 回读校验：用 df 的 1K 块总量对比块设备容量，不依赖 dumpe2fs
	fs_kb=$(df -k "$mp" 2>/dev/null | awk 'NR==2{print $2}')
	disk_blocks=$(cat "/sys/class/block/$disk/size" 2>/dev/null)
	if [ -n "$fs_kb" ] && [ -n "$disk_blocks" ]; then
		disk_kb=$((disk_blocks / 2))
		diff=$((disk_kb - fs_kb)); [ "$diff" -lt 0 ] && diff=$((-diff))
		if [ "$diff" -le $((disk_kb / 20)) ]; then
			log "OK: $mp 已扩满（${fs_kb}K / 磁盘 ${disk_kb}K）"
		else
			log "WARN: $mp 未完全扩满（fs=${fs_kb}K / disk=${disk_kb}K）"
		fi
	fi
}

log "=== rootfs-expand 开始 ==="
grow_one /
grow_one /overlay
log "=== rootfs-expand 结束 ==="
